import("../../roq.gni")
import("../../webrtc.gni")

assert(roq_repo_root != "",
       "roq_repo_root must point to the parent artc checkout")

copy("roq_test_certificates") {
  sources = [
    "cert.crt",
    "cert.key",
  ]
  outputs = [ "$root_out_dir/{{source_file_part}}" ]
}

rtc_library("livekit_roq_proto") {
  sources = [ "$roq_repo_root/src/generated/livekit_roq.pb.cc" ]
  include_dirs = [ "$roq_repo_root/src/generated" ]
  deps = [ "//third_party/protobuf:protobuf_lite" ]
  cflags_cc = [ "-Wno-unsafe-buffer-usage" ]
}

if (rtc_enable_file_capturer) {
  rtc_executable("roq_test_peer") {
    testonly = true

    # lld's parallel archive reader intermittently reports a phantom auto-link
    # search path during a same-invocation relink. Keep strict auto-link
    # checking enabled, but serialize archive reads for this target.
    if (use_lld) {
      ldflags = [ "-Wl,--read-workers=1" ]
    }
    sources = [
      "capability.cc",
      "capability.h",
      "file_capturer_probe.cc",
      "file_capturer_probe.h",
      "main.cc",
      "manifest.cc",
      "manifest.h",
      "media_peer.cc",
      "media_peer.h",
      "media_peer_mac.mm",
      "network_lab.cc",
      "network_lab.h",
      "quiche_abi.cc",
      "quiche_abi.h",
      "resumption_peer.cc",
      "resumption_peer.h",
      "roq_peer.cc",
      "roq_peer.h",
      "test_roq_server.cc",
      "test_roq_server.h",
    ]
    include_dirs = [ "$roq_repo_root/quiche/quiche/include" ]
    deps = [
      ":roq_test_certificates",
      "../../api:call_api",
      "../../api:scoped_refptr",
      "../../api:transport_api",
      "../../api/audio:audio_device",
      "../../api/audio:audio_frame_api",
      "../../api/audio:audio_mixer_api",
      "../../api/audio:create_audio_device_module",
      "../../api/audio_codecs:audio_codecs_api",
      "../../api/audio_codecs:builtin_audio_decoder_factory",
      "../../api/audio_codecs:builtin_audio_encoder_factory",
      "../../api/environment",
      "../../api/environment:environment_factory",
      "../../api/file_capturer:file_capturer_api",
      "../../api/roq:roq_api",
      "../../api/task_queue",
      "../../api/task_queue:pending_task_safety_flag",
      "../../api/test/video:function_video_factory",
      "../../api/units:time_delta",
      "../../api/units:timestamp",
      "../../api/video:builtin_video_bitrate_allocator_factory",
      "../../api/video:video_bitrate_allocation",
      "../../api/video:video_bitrate_allocator_factory",
      "../../api/video:video_frame",
      "../../api/video:video_frame_type",
      "../../api/video_codecs:builtin_video_decoder_factory",
      "../../api/video_codecs:builtin_video_encoder_factory",
      "../../api/video_codecs:video_codecs_api",
      "../../audio",
      "../../call",
      "../../call:call_interfaces",
      "../../call:video_receive_stream_api",
      "../../call:video_send_stream_api",
      "../../modules/audio_device:test_audio_device_module",
      "../../modules/audio_mixer:audio_mixer_impl",
      "../../modules/file_capturer:file_media_capturer",
      "../../modules/roq:roq_core",
      "../../modules/rtp_rtcp:rtp_rtcp_format",
      "../../modules/video_coding:codec_globals_headers",
      "../../modules/video_coding:video_codec_interface",
      "../../modules/video_coding:webrtc_h264",
      "../../rtc_base:copy_on_write_buffer",
      "../../rtc_base:crypto_random",
      "../../rtc_base:rtc_json",
      "../../rtc_base:task_queue_for_test",
      "../../rtc_base:threading",
      "../../rtc_base/network:sent_packet",
      "../../system_wrappers",
      "../../test:encoder_settings",
      "../../test:test_renderer",
      "../../test:video_test_common",
      "../../video/config:encoder_config",
      "//third_party/boringssl",
      "//third_party/ffmpeg",
      "//third_party/jsoncpp",
    ]
    libs = [ "$roq_repo_root/out/quiche/release/libquiche.a" ]
    cflags_cc = [ "-Wno-unsafe-buffer-usage" ]
  }
}

rtc_shared_library("livekit_roq_client") {
  output_name = "livekit_roq_client"
  ldflags = [ "-Wl,-install_name,@rpath/liblivekit_roq_client.dylib" ]
  if (use_lld) {
    ldflags += [ "-Wl,--read-workers=1" ]
  }
  sources = [
    "$roq_repo_root/src/native/livekit_roq/client_c_api.cc",
    "$roq_repo_root/src/native/livekit_roq/client_media.cc",
    "$roq_repo_root/src/native/livekit_roq/client_protocol.cc",
    "$roq_repo_root/src/native/livekit_roq/client_session.cc",
  ]
  include_dirs = [
    "$roq_repo_root/src",
    "$roq_repo_root/src/generated",
  ]
  deps = [
    ":livekit_roq_proto",
    "../../api/audio:create_audio_device_module",
    "../../api/audio_codecs:builtin_audio_decoder_factory",
    "../../api/environment:environment_factory",
    "../../api/roq:roq_api",
    "../../api/units:time_delta",
    "../../api/units:timestamp",
    "../../api/video_codecs:builtin_video_decoder_factory",
    "../../modules/roq:roq_core",
    "../../system_wrappers",
    "//third_party/protobuf:protobuf_lite",
  ]
  cflags_cc = [ "-Wno-unsafe-buffer-usage" ]
}

if (rtc_include_tests) {
  rtc_test("livekit_roq_protocol_unittests") {
    testonly = true
    sources = [
      "$roq_repo_root/src/native/livekit_roq/client_protocol.cc",
      "$roq_repo_root/src/native/livekit_roq/client_protocol_test.cc",
    ]
    include_dirs = [
      "$roq_repo_root/src",
      "$roq_repo_root/src/generated",
    ]
    deps = [
      ":livekit_roq_proto",
      "../../test:test_support",
      "//testing/gtest",
      "//third_party/protobuf:protobuf_lite",
    ]
    cflags_cc = [ "-Wno-unsafe-buffer-usage" ]
  }

  rtc_test("livekit_roq_client_unittests") {
    testonly = true
    if (use_lld) {
      ldflags = [ "-Wl,--read-workers=1" ]
    }
    sources = [
      "$roq_repo_root/src/native/livekit_roq/client_c_api.cc",
      "$roq_repo_root/src/native/livekit_roq/client_c_api_test.cc",
      "$roq_repo_root/src/native/livekit_roq/client_media.cc",
      "$roq_repo_root/src/native/livekit_roq/client_protocol.cc",
      "$roq_repo_root/src/native/livekit_roq/client_protocol_test.cc",
      "$roq_repo_root/src/native/livekit_roq/client_session.cc",
    ]
    include_dirs = [
      "$roq_repo_root/src",
      "$roq_repo_root/src/generated",
    ]
    deps = [
      ":livekit_roq_proto",
      "../../api/audio:create_audio_device_module",
      "../../api/audio_codecs:builtin_audio_decoder_factory",
      "../../api/environment:environment_factory",
      "../../api/roq:roq_api",
      "../../api/units:time_delta",
      "../../api/units:timestamp",
      "../../api/video_codecs:builtin_video_decoder_factory",
      "../../modules/roq:roq_core",
      "../../system_wrappers",
      "../../test:test_support",
      "//testing/gtest",
      "//third_party/protobuf:protobuf_lite",
    ]
    cflags_cc = [ "-Wno-unsafe-buffer-usage" ]
  }

  if (rtc_enable_file_capturer) {
    group("m2_unittests") {
      testonly = true
      deps = [
        "../../modules/file_capturer:file_media_capturer_unittests",
        "../../modules/roq:roq_sdk_unittests",
      ]
    }
  }

  group("m3_unittests") {
    testonly = true
    deps = [ "../../modules/roq:m3_unittests" ]
  }

  group("m4_unittests") {
    testonly = true
    deps = [ "../../modules/roq:roq_sdk_unittests" ]
  }

  rtc_test("roq_unittests") {
    testonly = true

    # Match roq_test_peer's lld workaround above.
    if (use_lld) {
      ldflags = [ "-Wl,--read-workers=1" ]
    }
    sources = [
      "quiche_abi_unittest.cc",
      "roq_wire_unittest.cc",
    ]
    include_dirs = [ "$roq_repo_root/quiche/quiche/include" ]
    deps = [
      "../../modules/roq:roq_core",
      "../../test:test_support",
      "//testing/gtest",
    ]
  }
}
