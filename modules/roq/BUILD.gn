import("../../roq.gni")
import("../../webrtc.gni")

assert(rtc_enable_artc_sdk,
       "rtc_enable_artc_sdk must be true to build RoQ targets")
assert(roq_quiche_include_dir != "",
       "roq_quiche_include_dir must point to the quiche C headers")
assert(roq_quiche_library != "", "roq_quiche_library must point to libquiche")

config("quiche") {
  include_dirs = [ roq_quiche_include_dir ]
  libs = [ roq_quiche_library ]
}

rtc_library("roq_core") {
  visibility = [ "*" ]
  sources = [
    "bounded_datagram_queue.cc",
    "bounded_datagram_queue.h",
    "quic_bandwidth_policy.cc",
    "quic_bandwidth_policy.h",
    "quic_network_controller.cc",
    "receive_flow_registry.cc",
    "receive_flow_registry.h",
    "reliable_message_framer.cc",
    "reliable_message_framer.h",
    "resumption_cache.cc",
    "resumption_cache.h",
    "roq_media_engine.cc",
    "roq_session.cc",
    "roq_transport.cc",
    "roq_wire.cc",
    "roq_wire.h",
    "rtp_packet_metadata.cc",
    "rtp_packet_metadata.h",
  ]
  public_configs = [ ":quiche" ]
  deps = [
    "../../api:call_api",
    "../../api:scoped_refptr",
    "../../api/audio:audio_frame_api",
    "../../api/audio:audio_mixer_api",
    "../../api/audio:builtin_audio_processing_builder",
    "../../api/audio_codecs:audio_codecs_api",
    "../../api/environment",
    "../../api/roq:roq_api",
    "../../api/task_queue:pending_task_safety_flag",
    "../../api/transport:network_control",
    "../../api/units:data_rate",
    "../../api/units:time_delta",
    "../../api/units:timestamp",
    "../../api/video:builtin_video_bitrate_allocator_factory",
    "../../api/video:video_bitrate_allocator_factory",
    "../../api/video:video_frame",
    "../../api/video_codecs:video_codecs_api",
    "../../audio",
    "../../call",
    "../../call:call_interfaces",
    "../../call:rtp_interfaces",
    "../../call:video_receive_stream_api",
    "../../call:video_send_stream_api",
    "../../modules/audio_mixer:audio_mixer_impl",
    "../../modules/rtp_rtcp:rtp_rtcp_format",
    "../../modules/video_coding:codec_globals_headers",
    "../../rtc_base:copy_on_write_buffer",
    "../../rtc_base:crypto_random",
    "../../rtc_base:logging",
    "../../rtc_base:network_route",
    "../../rtc_base:threading",
    "../../rtc_base:timeutils",
    "../../rtc_base/network:sent_packet",
    "../../rtc_base/synchronization:mutex",
    "../../video/config:encoder_config",
    "//third_party/boringssl",
  ]
}

if (rtc_include_tests) {
  rtc_test("roq_sdk_unittests") {
    testonly = true
    sources = [
      "bounded_datagram_queue_unittest.cc",
      "quic_bandwidth_policy_unittest.cc",
      "quic_network_controller_unittest.cc",
      "receive_flow_registry_unittest.cc",
      "reliable_message_framer_unittest.cc",
      "resumption_cache_unittest.cc",
      "roq_media_engine_unittest.cc",
      "roq_session_unittest.cc",
      "roq_transport_unittest.cc",
      "rtp_packet_metadata_unittest.cc",
    ]
    deps = [
      ":roq_core",
      "../../api/audio:create_audio_device_module",
      "../../api/audio_codecs:builtin_audio_decoder_factory",
      "../../api/audio_codecs:builtin_audio_encoder_factory",
      "../../api/environment",
      "../../api/environment:environment_factory",
      "../../api/roq:roq_api",
      "../../api/transport:network_control",
      "../../api/units:data_rate",
      "../../api/units:time_delta",
      "../../api/units:timestamp",
      "../../api/video:video_frame",
      "../../api/video_codecs:builtin_video_decoder_factory",
      "../../api/video_codecs:builtin_video_encoder_factory",
      "../../modules/audio_device:mock_audio_device",
      "../../modules/rtp_rtcp:rtp_rtcp_format",
      "../../system_wrappers",
      "../../test:create_test_environment",
      "../../test:test_support",
      "//testing/gtest",
    ]
  }
}
